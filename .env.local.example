# Copia este archivo a ".env.local" (mismo nombre, sin ".example")
# y completa los valores. Ver README.md para instrucciones detalladas
# de dónde sacar cada uno.
#
# IMPORTANTE: NEXU usa un proyecto de Supabase PROPIO, distinto al de
# la app de tareas. No reutilices las mismas claves.

# Panel de Supabase -> tu proyecto NEXU -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Project Settings -> API -> "Secret keys" (¡NUNCA la compartas ni la
# subas a GitHub! Solo se usa en el servidor, para generar enlaces de
# descarga seguros de las evidencias.)
SUPABASE_SERVICE_ROLE_KEY=tu-secret-key-aqui
